rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isVerified() {
      return request.auth != null
        && (request.auth.token.email_verified == true
            || request.auth.token.phone_number != null);
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Profiles: any signed-in user can read; only the owner can write
    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.followers == 0
        && request.resource.data.following == 0
        && !request.resource.data.keys().hasAny(['verified', 'verifiedRole', 'verifiedAt', 'banned']);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['followers', 'following', 'createdAt', 'verified', 'verifiedRole', 'verifiedAt', 'banned']);

      // admins can only change the badge fields
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['verified', 'verifiedRole', 'verifiedAt']);

      allow delete: if false;

      match /playlists/{pid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'tracks', 'color', 'createdAt', 'updatedAt'])
          && (!('color' in request.resource.data)
              || (request.resource.data.color is string
                  && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')))
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 40
          && request.resource.data.tracks is list
          && request.resource.data.tracks.size() <= 100;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /following/{otherId} {
        allow read: if request.auth != null;
        allow create: if isVerified() && request.auth.uid == uid && otherId != uid;
        allow delete: if request.auth.uid == uid;
      }

      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow create: if isVerified() && request.auth.uid == followerId && followerId != uid;
        allow delete: if request.auth.uid == followerId;
      }

      match /notifications/{nid} {
        // you can only read your own
        allow read: if request.auth != null && request.auth.uid == uid;

        // a follower can leave one "follow" note, and the name must be really theirs
        allow create: if isVerified()
          && uid != request.auth.uid
          && nid == 'follow_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['type', 'fromUid', 'fromUsername', 'createdAt', 'read'])
          && request.resource.data.type == 'follow'
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUsername ==
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time;

        // an admin can send the "you're verified" note
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['type', 'role', 'createdAt', 'read'])
          && request.resource.data.type == 'verified'
          && request.resource.data.role is string
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time;

        // you can mark your own as read
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        // you can delete your own; a follower can take back their own follow note
        allow delete: if request.auth != null
          && (request.auth.uid == uid || nid == 'follow_' + request.auth.uid);
      }
    }

    // Username claims: look up one name at a time, no listing
    match /usernames/{name} {
      allow get: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && name.matches('^[a-z0-9_.]{3,20}$');

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    // Admins: only you, added by hand in the console
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Reports: verified users can send one per person; only admins can read or change them
    match /reports/{rid} {
      allow create: if isVerified()
        && rid == request.auth.uid + '_' + request.resource.data.targetUid
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['reporterUid', 'targetUid', 'targetUsername', 'reason',
              'details', 'link', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['reporterUid', 'targetUid', 'targetUsername', 'reason',
              'details', 'status', 'createdAt'])
        && request.resource.data.reason in
             ['spam', 'harassment', 'impersonation', 'fake_verified',
              'inappropriate', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 10
        && request.resource.data.details.size() <= 500
        && request.resource.data.targetUsername is string
        && request.resource.data.targetUsername.size() <= 30
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && (!('link' in request.resource.data)
            || (request.resource.data.link is string
                && request.resource.data.link.size() <= 300
                && request.resource.data.link.matches('^https://.*')));

      allow read, update, delete: if isAdmin();
    }

    // Verification requests: one per person (the ID is their user ID)
    match /verifyRequests/{rid} {
      allow create: if isVerified()
        && rid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'username', 'role', 'code', 'proofLink', 'note',
              'status', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['uid', 'username', 'role', 'code', 'proofLink',
              'status', 'createdAt'])
        && request.resource.data.role in ['athlete', 'coach', 'media']
        && request.resource.data.code.matches('^AB-[A-Z0-9]{6}$')
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 30
        && request.resource.data.proofLink is string
        && request.resource.data.proofLink.size() <= 300
        && request.resource.data.proofLink.matches('^https://.*')
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 300))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin() || (request.auth != null && request.auth.uid == rid);
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == rid
            && resource.data.status != 'approved');
    }
  }
}